{
  "name": "itsjustvita/laravel-znuny",
  "description": "Laravel SDK for the Znuny / OTRS Community Edition Generic Interface REST API",
  "keywords": ["laravel", "znuny", "otrs", "ticket", "helpdesk", "sdk", "api", "rest", "generic-interface"],
  "license": "MIT",
  "authors": [
    {
      "name": "Vitalis Feist-Wurm",
      "email": "hello@itsjustvita.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "illuminate/cache": "^12.0 || ^13.0",
    "illuminate/console": "^12.0 || ^13.0",
    "illuminate/events": "^12.0 || ^13.0",
    "illuminate/http": "^12.0 || ^13.0",
    "illuminate/log": "^12.0 || ^13.0",
    "illuminate/pagination": "^12.0 || ^13.0",
    "illuminate/routing": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0",
    "nesbot/carbon": "^3.0"
  },
  "require-dev": {
    "laravel/pint": "^1.0",
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^12.0"
  },
  "suggest": {
    "ext-fileinfo": "Detects attachment MIME types in Attachment::fromPath()"
  },
  "autoload": {
    "psr-4": {
      "ItsJustVita\\LaravelZnuny\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItsJustVita\\LaravelZnuny\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItsJustVita\\LaravelZnuny\\ZnunyServiceProvider"
      ],
      "aliases": {
        "Znuny": "ItsJustVita\\LaravelZnuny\\Facades\\Znuny"
      }
    }
  },
  "scripts": {
    "test": "phpunit",
    "format": "pint"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true
  }
}
