<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
    <php>
        <env name="ZNUNY_BASE_URL" value="https://znuny.test/otrs/nph-genericinterface.pl/Webservice/test"/>
        <env name="ZNUNY_USERNAME" value="testuser"/>
        <env name="ZNUNY_PASSWORD" value="testpass"/>
        <env name="ZNUNY_VERIFY_SSL" value="false"/>
    </php>
</phpunit>
