<?php

namespace App\Znuny;

/**
 * Typed helper for Znuny dynamic fields. Auto-generated by `php artisan znuny:generate-fields`.
 * Regenerate after changing config/znuny.php.
 */
class DynamicFields
{
    /** @var array<string, mixed> */
    private array $fields = [];

    public static function make(): self
    {
        return new self();
    }

    public function toArray(): array
    {
        return $this->fields;
    }

{{ methods }}
}
